<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  CinemaUQ - Proyecto Final - Programación II
  ============================================================================
  Proyecto Maven para la gestión integral de un cine (JavaFX + MVC).
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cinemauq</groupId>
    <artifactId>cinemauq</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>CinemaUQ</name>
    <description>Sistema Integral de Gestión de Cine (Proyecto Final - Programación II)</description>

    <properties>
        <!-- Codificación de fuentes -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Java 17 -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Versión de JavaFX -->
        <javafx.version>21.0.6</javafx.version>
    </properties>

    <dependencies>
        <!-- JavaFX Controls -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compilador Maven -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- Plugin JavaFX -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.cinemauq.Main</mainClass>
                </configuration>
            </plugin>

            <!-- Plugin Exec para pruebas por consola si se requiere -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <mainClass>com.cinemauq.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
